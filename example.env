# ===============================
# 🌐 WEBSITE CONFIGURATION
# ===============================
WEBSITE_URL=https://your-domain.com/en/track?c=usd1



# ===============================
# 🧠 PUPPETEER SETTINGS
# ===============================
PUPPETEER_HEADLESS=false
PUPPETEER_START_MAXIMIZED=true
PUPPETEER_DEFAULT_VIEWPORT=null


# ===============================
# 💳 CARD DETAILS (USE DUMMY DATA)
# ===============================
CARD_NUMBER=0000000000000000
CARD_EXPIRY=MM/YY
CARD_CVV=000


# ===============================
# 📊 REPORT GENERATION
# ===============================
REPORT_COUNT=1


# ===============================
# ⏱️ AUTOMATION SETTINGS
# ===============================
# Delay between clicks & inputs (in milliseconds)
COMMON_DELAY_ONCLICKS=200


# ===============================
# 👤 USER SETTINGS
# ===============================
# Number of users to register
USER_REGISTRATION_COUNT=1


# ===============================
# 🔓 REPORT UNLOCK SETTINGS
# ===============================
# true or false
UNLOCK_REPORT=false