# ===============================
# 🌐 WEBSITE CONFIGURATION
# ===============================
WEBSITE_URL=https://your-website.com/

# ===============================
# 🧠 PUPPETEER SETTINGS
# ===============================
PUPPETEER_HEADLESS= true/flase
PUPPETEER_START_MAXIMIZED=true/false
PUPPETEER_DEFAULT_VIEWPORT=null

# ===============================
# 💳 CARD DETAILS
# ===============================
CARD_NUMBER=0000000000000000
CARD_EXPIRY=mm/yy
CARD_CVV=000

# ===============================
# 📊 REPORT GENERATION
# ===============================
REPORT_COUNT=1 # Number of reports to generate
ENABLE_CREATE_REPORT = false # true or false 

# ===============================
# ⏱️ AUTOMATION SETTINGS
# ===============================
# Retry configuration
MAX_RETRIES=5
RETRY_DELAY_MS=5000

# Timeout settings (in milliseconds)
PAGE_TIMEOUT=00000 #waiting time for page load
IFRAME_TIMEOUT=00000 #//waiting time for iframe load
REPORT_TIMEOUT=00000 #//waiting time for report generation

# Delay settings (in milliseconds)
COMMON_DELAY_ONCLICKS=200 #delay after each click
TYPING_DELAY=50

# ===============================
# 👤 USER SETTINGS
# ===============================
# Number of users to register
USER_REGISTRATION_COUNT=1

# ===============================
# 🔓 REPORT UNLOCK SETTINGS
# ===============================
# true or false
UNLOCK_REPORT=false


# ===============================
# ▶️ + ⚙️ EXECUTION FLOW  SETTINGS
# ===============================

ENABLE_DISCOUNTED_FULL_FLOW = true
ENABLE_PRO_ACCESS_FLOW = false
ENABLE_STANDARD_FLOW = false
ENABLE_PAID_PLATFORM_ACCESS = false